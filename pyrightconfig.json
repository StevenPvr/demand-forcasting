{
  "include": [
    "apps",
    "platform/python/src",
    "products/demand_forecast/src",
    "praedixa",
    "tests"
  ],
  "extraPaths": [
    "platform/python/src",
    "products/demand_forecast/src"
  ],
  "executionEnvironments": [
    {
      "root": "apps",
